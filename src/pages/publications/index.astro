---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationRow from '../../components/PublicationRow.astro';
import { getPublications } from '../../lib/publications';

const publications = await getPublications();
---

<BaseLayout title="Publications" description="Publications by Chenglong Ma.">
  <main class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Research output</p>
      <h1>Publications</h1>
      <p class="lede">Research on user behaviour, simulation, search, recommendation, and responsible AI.</p>
    </header>
    <div class="publication-list">
      {publications.map((publication) => <PublicationRow publication={publication} compact />)}
    </div>
  </main>
</BaseLayout>
