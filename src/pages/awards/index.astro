---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const awards = (await getCollection('awards')).filter((award) => !award.data.hidden).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Awards">
  <main class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Recognition</p>
      <h1>Awards</h1>
      <p class="lede">Academic recognition.</p>
    </header>
    {awards.length ? <div class="award-list">
      {awards.map((award) => (
        <article class="award-row">
          <p class="award-date">{award.data.year}</p>
          <div><h2>{award.data.title}</h2><p>{award.data.issuer}</p>{award.data.summary && <p>{award.data.summary}</p>}</div>
        </article>
      ))}
    </div> : <p class="empty-message">No awards are currently listed.</p>}
  </main>
</BaseLayout>
