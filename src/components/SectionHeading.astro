---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, id, href, linkLabel = 'View all' } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
  </div>
  {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true"> ↗</span></a>}
</div>
